[Unit]
Description=LiteLLM proxy
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ litellm_home }}

[Service]
Type=simple
User={{ litellm_user }}
Group={{ litellm_user }}
WorkingDirectory={{ litellm_root }}
Environment=HOME={{ litellm_home }}
Environment=CHATGPT_TOKEN_DIR={{ litellm_state }}/chatgpt
Environment=CLAUDE_ADAPTER_STATE={{ litellm_state }}/claude
Environment=LITELLM_LOCAL_MODEL_COST_MAP=True
Environment=LITELLM_TELEMETRY=False
Environment=UV_OFFLINE=1
Environment=UV_PYTHON_DOWNLOADS=never
Environment=LITELLM_VOICE_ENABLED={{ litellm_voice_enabled | bool | ternary('true', 'false') }}
Environment=COMPACTION_FALLBACK_ENABLED={{ compaction_fallback_enabled | bool | ternary('true', 'false') }}
Environment=COMPACTION_MODEL_CATALOG={{ litellm_config }}/codex-models.json
LoadCredentialEncrypted=litellm-proxy-key:{{ litellm_system_credential }}
{% for credential in litellm_credentials %}
LoadCredentialEncrypted={{ credential.name }}:{{ credential.path }}
{% endfor %}
ExecStart={{ litellm_root }}/scripts/start-litellm {{ litellm_uv }} {{ litellm_root }} {{ litellm_config }}/config.yaml
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
