[Unit]
Description=LiteLLM model proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ litellm_user }}
Group={{ litellm_user }}
WorkingDirectory={{ litellm_root }}
Environment=HOME={{ litellm_home }}
Environment=CHATGPT_TOKEN_DIR={{ litellm_state }}/chatgpt
Environment=CLAUDE_ADAPTER_STATE={{ litellm_state }}/claude
Environment=LITELLM_LOCAL_MODEL_COST_MAP=True
Environment=LITELLM_TELEMETRY=False
Environment=COMPACTION_FALLBACK_ENABLED={{ (compaction_fallback_enabled | default(false) | bool) | ternary('true', 'false') }}
Environment=COMPACTION_MODEL_CATALOG={{ litellm_config }}/codex-models.json
Environment=UV_OFFLINE=1
Environment=UV_PYTHON_DOWNLOADS=never
LoadCredentialEncrypted=litellm-proxy-key:/etc/credstore.encrypted/litellm-proxy-key
LoadCredentialEncrypted=modal-inference-token:{{ litellm_modal_credential }}
{% if litellm_cerebras_enabled | default(false) %}
LoadCredentialEncrypted=cerebras-api-key:{{ litellm_cerebras_credential }}
{% endif %}
{% if litellm_bedrock_enabled | default(false) %}
LoadCredentialEncrypted=bedrock-aws-credentials:{{ litellm_bedrock_credential }}
{% endif %}
ExecStart={{ litellm_root }}/scripts/start-litellm {{ litellm_uv }} {{ litellm_root }} {{ litellm_config }}/config.yaml
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
